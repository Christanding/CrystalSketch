{
  "id": "satin-matte",
  "label": "丝缎哑光",
  "description": "A quiet satin finish with broad low-intensity highlights and no atom or bond contour.",
  "material": {
    "type": "MeshStandardMaterial",
    "props": { "metalness": 0, "roughness": 0.62, "flatShading": false }
  },
  "overrides": {
    "polyhedron": { "material": { "type": "MeshToonMaterial", "props": {} } }
  },
  "lighting": [
    { "type": "AmbientLight", "props": { "intensity": 0.6 } },
    { "type": "cameraDirectional", "props": { "intensity": 0.7, "offset": [1.5, 1.5, 0] } },
    { "type": "cameraDirectional", "props": { "intensity": 0.2, "offset": [-1, -1, -2], "fixedDirection": true } }
  ]
}
